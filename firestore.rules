rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == "chartech031@gmail.com";
    }
    function owner(businessId) { return signedIn() && request.auth.uid == businessId; }
    function participant(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["uid","displayName","photoURL","updatedAt"])
        && request.resource.data.keys().hasAll(["uid","displayName","photoURL"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048;
      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName","photoURL","updatedAt"])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["uid","displayName","email","photoURL","bio","updatedAt","createdAt"])
        && (!("uid" in request.resource.data) || request.resource.data.uid == uid)
        && (!("email" in request.resource.data) || request.resource.data.email is string);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /conversations/{conversationId} {
      // Autoriser la lecture d'un identifiant de conversation encore inexistant
      // afin que le client puisse vérifier son absence avant de le créer.
      // Si le document existe déjà, seuls ses participants peuvent le lire.
      allow read: if signedIn()
        && (
          !exists(/databases/$(database)/documents/conversations/$(conversationId))
          || request.auth.uid in resource.data.participants
        );
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["participants","participantInfo","createdAt","lastMessage","lastMessageAt","lastSenderId"])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastMessage","lastMessageAt","lastSenderId"])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 120
        && request.resource.data.lastSenderId == request.auth.uid;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if participant(conversationId);
        allow create: if participant(conversationId)
          && request.resource.data.keys().hasOnly(["senderId","receiverId","text","createdAt"])
          && request.resource.data.keys().hasAll(["senderId","receiverId","text"])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId is string
          && request.resource.data.receiverId in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.receiverId != request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update: if false;
        allow delete: if participant(conversationId) && resource.data.senderId == request.auth.uid;
      }
    }

    match /messages/{messageId} {
      allow read, create, update, delete: if false;
    }

    match /businesses/{businessId} {
      allow read: if owner(businessId);
      allow create: if owner(businessId)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(["ownerId","name","phone","createdAt","updatedAt"]);
      allow update: if owner(businessId)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name","phone","updatedAt"]);
      allow delete: if false;

      match /products/{productId} {
        allow read: if owner(businessId);
        allow create: if owner(businessId)
          && request.resource.data.keys().hasOnly(["name","costPrice","price","stock","manufactureDate","expiryDate","lowStockThreshold","createdAt","updatedAt"])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.price is number
          && request.resource.data.price >= 0
          && (!("costPrice" in request.resource.data) || (request.resource.data.costPrice is number && request.resource.data.costPrice >= 0))
          && (!("manufactureDate" in request.resource.data) || request.resource.data.manufactureDate is string)
          && (!("expiryDate" in request.resource.data) || request.resource.data.expiryDate is string)
          && request.resource.data.stock is number
          && request.resource.data.stock >= 0
          && request.resource.data.lowStockThreshold is number;
        allow update: if owner(businessId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name","costPrice","price","stock","manufactureDate","expiryDate","lowStockThreshold","updatedAt","lastStockMoveId"])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.price is number
          && request.resource.data.price >= 0
          && (!("costPrice" in request.resource.data) || (request.resource.data.costPrice is number && request.resource.data.costPrice >= 0))
          && (!("manufactureDate" in request.resource.data) || request.resource.data.manufactureDate is string)
          && (!("expiryDate" in request.resource.data) || request.resource.data.expiryDate is string)
          && request.resource.data.stock is number
          && request.resource.data.stock >= 0
          && (
            (
              request.resource.data.stock == resource.data.stock
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["lastStockMoveId"])
            )
            ||
            (
              request.resource.data.stock != resource.data.stock
              && request.resource.data.lastStockMoveId is string
              && !exists(/databases/$(database)/documents/businesses/$(businessId)/stockMoves/$(request.resource.data.lastStockMoveId))
              && existsAfter(/databases/$(database)/documents/businesses/$(businessId)/stockMoves/$(request.resource.data.lastStockMoveId))
              && getAfter(/databases/$(database)/documents/businesses/$(businessId)/stockMoves/$(request.resource.data.lastStockMoveId)).data.productId == productId
              && getAfter(/databases/$(database)/documents/businesses/$(businessId)/stockMoves/$(request.resource.data.lastStockMoveId)).data.quantity == request.resource.data.stock - resource.data.stock
            )
          );
        allow delete: if false;
      }

      match /sales/{saleId} {
        allow read: if owner(businessId);
        allow create: if owner(businessId)
          && request.resource.data.keys().hasOnly(["productId","productName","quantity","amount","costKnown","unitCost","costTotal","grossProfit","stockMoveId","createdAt"])
          && request.resource.data.productId is string
          && request.resource.data.productName is string
          && request.resource.data.quantity is number
          && request.resource.data.quantity > 0
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && (!("costKnown" in request.resource.data) || request.resource.data.costKnown is bool)
          && (!("unitCost" in request.resource.data) || (request.resource.data.unitCost is number && request.resource.data.unitCost >= 0))
          && (!("costTotal" in request.resource.data) || (request.resource.data.costTotal is number && request.resource.data.costTotal >= 0))
          && (!("grossProfit" in request.resource.data) || request.resource.data.grossProfit is number)
          && request.resource.data.stockMoveId is string
          && existsAfter(/databases/$(database)/documents/businesses/$(businessId)/stockMoves/$(request.resource.data.stockMoveId))
          && getAfter(/databases/$(database)/documents/businesses/$(businessId)/stockMoves/$(request.resource.data.stockMoveId)).data.saleId == saleId
          && getAfter(/databases/$(database)/documents/businesses/$(businessId)/stockMoves/$(request.resource.data.stockMoveId)).data.productId == request.resource.data.productId
          && getAfter(/databases/$(database)/documents/businesses/$(businessId)/stockMoves/$(request.resource.data.stockMoveId)).data.quantity == 0 - request.resource.data.quantity;
        allow update, delete: if false;
      }

      match /customers/{customerId} {
        allow read: if owner(businessId);
        allow create: if owner(businessId)
          && request.resource.data.keys().hasOnly(["name","phone","createdAt","updatedAt"])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.phone is string
          && request.resource.data.phone.size() <= 40;
        allow update, delete: if false;
      }

      match /debts/{debtId} {
        allow read: if owner(businessId);
        allow create: if owner(businessId)
          && request.resource.data.keys().hasOnly(["customerId","customerName","amount","paidAmount","note","status","createdAt"])
          && request.resource.data.customerId is string
          && request.resource.data.customerName is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.paidAmount == 0
          && request.resource.data.status == "open";
        allow update: if owner(businessId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paidAmount","status","lastPaymentId","updatedAt"])
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.customerName == resource.data.customerName
          && request.resource.data.amount == resource.data.amount
          && request.resource.data.paidAmount is number
          && request.resource.data.paidAmount > resource.data.paidAmount
          && request.resource.data.paidAmount <= resource.data.amount
          && request.resource.data.status == (request.resource.data.paidAmount == request.resource.data.amount ? "paid" : "partial")
          && request.resource.data.lastPaymentId is string
          && existsAfter(/databases/$(database)/documents/businesses/$(businessId)/debtPayments/$(request.resource.data.lastPaymentId))
          && getAfter(/databases/$(database)/documents/businesses/$(businessId)/debtPayments/$(request.resource.data.lastPaymentId)).data.debtId == debtId
          && getAfter(/databases/$(database)/documents/businesses/$(businessId)/debtPayments/$(request.resource.data.lastPaymentId)).data.amount == request.resource.data.paidAmount - resource.data.paidAmount;
        allow delete: if false;
      }

      match /debtPayments/{paymentId} {
        allow read: if owner(businessId);
        allow create: if owner(businessId)
          && request.resource.data.keys().hasOnly(["debtId","customerId","customerName","amount","note","createdAt"])
          && request.resource.data.debtId is string
          && request.resource.data.customerId is string
          && request.resource.data.customerName is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && exists(/databases/$(database)/documents/businesses/$(businessId)/debts/$(request.resource.data.debtId))
          && get(/databases/$(database)/documents/businesses/$(businessId)/debts/$(request.resource.data.debtId)).data.customerId == request.resource.data.customerId
          && existsAfter(/databases/$(database)/documents/businesses/$(businessId)/debts/$(request.resource.data.debtId))
          && getAfter(/databases/$(database)/documents/businesses/$(businessId)/debts/$(request.resource.data.debtId)).data.lastPaymentId == paymentId
          && getAfter(/databases/$(database)/documents/businesses/$(businessId)/debts/$(request.resource.data.debtId)).data.paidAmount == get(/databases/$(database)/documents/businesses/$(businessId)/debts/$(request.resource.data.debtId)).data.paidAmount + request.resource.data.amount;
        allow update, delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if owner(businessId);
        allow create: if owner(businessId)
          && request.resource.data.keys().hasOnly(["label","amount","note","createdAt"])
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 120
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 160;
        allow update, delete: if false;
      }

      match /stockMoves/{moveId} {
        allow read: if owner(businessId);
        allow create: if owner(businessId)
          && request.resource.data.keys().hasOnly(["productId","productName","type","quantity","saleId","lossId","unitCost","totalCost","note","createdAt"])
          && request.resource.data.productId is string
          && request.resource.data.productName is string
          && request.resource.data.type in ["purchase","sale"]
          && request.resource.data.quantity is number
          && (
            (request.resource.data.type == "purchase" && request.resource.data.quantity > 0)
            || (request.resource.data.type == "sale" && request.resource.data.quantity < 0)
          )
          && exists(/databases/$(database)/documents/businesses/$(businessId)/products/$(request.resource.data.productId))
          && existsAfter(/databases/$(database)/documents/businesses/$(businessId)/products/$(request.resource.data.productId))
          && getAfter(/databases/$(database)/documents/businesses/$(businessId)/products/$(request.resource.data.productId)).data.lastStockMoveId == moveId
          && getAfter(/databases/$(database)/documents/businesses/$(businessId)/products/$(request.resource.data.productId)).data.stock
              == get(/databases/$(database)/documents/businesses/$(businessId)/products/$(request.resource.data.productId)).data.stock + request.resource.data.quantity
          && (
            request.resource.data.type == "purchase"
            || (
              request.resource.data.saleId is string
              && existsAfter(/databases/$(database)/documents/businesses/$(businessId)/sales/$(request.resource.data.saleId))
              && getAfter(/databases/$(database)/documents/businesses/$(businessId)/sales/$(request.resource.data.saleId)).data.stockMoveId == moveId
              && getAfter(/databases/$(database)/documents/businesses/$(businessId)/sales/$(request.resource.data.saleId)).data.productId == request.resource.data.productId
              && getAfter(/databases/$(database)/documents/businesses/$(businessId)/sales/$(request.resource.data.saleId)).data.quantity == 0 - request.resource.data.quantity
            )
          );
        allow update, delete: if false;
      }
    }

    match /visits/{visitId} {
      allow create, update: if request.resource.data.keys().hasOnly(["lastPage","updatedAt","userAgentClass"])
        && request.resource.data.lastPage is string
        && request.resource.data.lastPage.size() <= 120
        && request.resource.data.userAgentClass in ["mobile","desktop"];
      allow read: if admin();
      allow delete: if false;
    }

    match /media/{id} {
      allow read: if resource.data.visibility == "public" || admin();
      allow create, update, delete: if admin();
    }

    match /documents/{id} {
      allow read: if resource.data.visibility == "public" || admin();
      allow create, update, delete: if admin();
    }
  }
}