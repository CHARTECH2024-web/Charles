rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function admin() {
      return signedIn() && request.auth.token.email == "chartech031@gmail.com";
    }

    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000;
      allow update, delete: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /visits/{visitId} {
      allow create, update: if true
        && request.resource.data.lastPage is string
        && request.resource.data.lastPage.size() <= 120;
      allow read: if admin();
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (request.auth.uid == uid || admin());
    }

    match /media/{id} {
      allow read: if resource.data.visibility == "public" || admin();
      allow create, update, delete: if admin();
    }

    match /documents/{id} {
      allow read: if resource.data.visibility == "public" || admin();
      allow create, update, delete: if admin();
    }
  }
}