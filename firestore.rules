rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.email == "chartech031@gmail.com"; }
    function participant(conversationId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    // Private user directory: only non-sensitive public identity fields are stored here.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    // Personal profile documents.
    match /profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create, update: if signedIn() && (request.auth.uid == uid || admin());
    }

    // One-to-one conversations. A conversation always contains exactly two user UIDs.
    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastMessage","lastMessageAt","lastSenderId"
        ]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if participant(conversationId);
        allow create: if participant(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId is string
          && request.resource.data.receiverId in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.receiverId != request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if participant(conversationId)
          && resource.data.senderId == request.auth.uid;
      }
    }

    // Legacy public-room documents are kept isolated from V3.3 private messaging.
    match /messages/{messageId} {
      allow read, create, update, delete: if false;
    }

    // V3.4 — Cahier de Compte.
    // Each business workspace is owned by exactly one authenticated user.
    match /businesses/{businessId} {
      allow read: if signedIn() && request.auth.uid == businessId;
      allow create: if signedIn()
        && request.auth.uid == businessId
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if signedIn()
        && request.auth.uid == businessId
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if false;

      match /products/{productId} {
        allow read: if signedIn() && request.auth.uid == businessId;
        allow create, update: if signedIn()
          && request.auth.uid == businessId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.price is number
          && request.resource.data.price >= 0
          && request.resource.data.stock is number
          && request.resource.data.stock >= 0;
        allow delete: if signedIn() && request.auth.uid == businessId;
      }

      match /sales/{saleId} {
        allow read: if signedIn() && request.auth.uid == businessId;
        allow create: if signedIn()
          && request.auth.uid == businessId
          && request.resource.data.productId is string
          && request.resource.data.productName is string
          && request.resource.data.quantity is number
          && request.resource.data.quantity > 0
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0;
        allow update, delete: if signedIn() && request.auth.uid == businessId;
      }

      match /customers/{customerId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == businessId;
      }

      match /debts/{debtId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == businessId;
      }

      match /expenses/{expenseId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == businessId;
      }
    }

    match /visits/{visitId} {
      allow create, update: if request.resource.data.lastPage is string
        && request.resource.data.lastPage.size() <= 120;
      allow read: if admin();
    }

    match /media/{id} {
      allow read: if resource.data.visibility == "public" || admin();
      allow create, update, delete: if admin();
    }

    match /documents/{id} {
      allow read: if resource.data.visibility == "public" || admin();
      allow create, update, delete: if admin();
    }
  }
}